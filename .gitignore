# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing
/playwright-report
/test-results

/src/generated/prisma

# AI agent-skill docs auto-installed by `prisma init` (vendored tool docs,
# not app code — reinstall via the Prisma CLI if needed, not tracked here)
/.agents/skills
/.claude/skills
/.windsurf/skills
/skills-lock.json
