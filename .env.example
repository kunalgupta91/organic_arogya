# ─────────────────────────────────────────────────────────────
# Organic Arogya — environment variables
# Copy this file to .env (local dev) and to your Vercel project
# settings (production/preview). Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (Neon Postgres in production) ---
# Create a project at https://neon.tech, copy the pooled connection string.
# For local dev, run `npx prisma dev` instead (see README) and it will
# print a connection string to use here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Local dev only — shadow DB used by `prisma migrate dev` for diffing.
# Not needed/used against Neon in production.
SHADOW_DATABASE_URL=""

# --- Seed script (local/dev only — creates a default admin login) ---
SEED_ADMIN_EMAIL="admin@organicarogya.com"
SEED_ADMIN_PASSWORD="changeme123"

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google OAuth: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Cloudinary (product images, PDFs, certificates) ---
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Resend (transactional email) ---
# https://resend.com/api-keys — verify your sending domain first.
RESEND_API_KEY=""
ORDER_NOTIFICATION_EMAIL="info@organicarogya.com"

# --- Razorpay (primary payment provider — India, UPI/cards/netbanking/wallets) ---
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Stripe (international — adapter wired, dormant until keys are set) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Docker Compose only (self-hosted deployment, not needed for Vercel) ---
POSTGRES_PASSWORD="changeme"
